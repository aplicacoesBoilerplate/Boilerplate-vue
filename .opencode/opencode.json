{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/AGENTS.md"],
  "mcp": {
    "MCP_DOCKER": {
      "type": "local",
      "command": ["docker.exe", "mcp", "gateway", "run", "--profile", "k6_mcps"],
      "enabled": true
    },
    "pencil": {
      "type": "local",
      "command": [
        "C:\\Users\\Gerson Ribeiro\\.pencil\\mcp\\visual_studio_code\\out\\mcp-server-windows-x64.exe",
        "--app",
        "visual_studio_code",
        "--agent",
        "copilotIDE"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
      }
    }
  }
}
