{
  "name": "frontend",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:e2e": "playwright test",
    "test:memory": "playwright test tests/e2e/memory-retention.spec.ts --project=chromium",
    "build-only": "vite build",
    "verify": "run-s lint type-check test:unit:run build-only check:bundle test:e2e",
    "type-check": "vue-tsc --build",
    "lint": "eslint --config config/eslint.config.js .",
    "lint:fix": "eslint --config config/eslint.config.js . --fix",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "format": "prettier . --write",
    "release": "standard-version --config config/.versionrc.cjs",
    "prepare": "husky",
    "generate-pwa-assets": "pwa-assets-generator --config config/pwa-assets.config.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "apexcharts": "^5.15.2",
    "axios": "^1.19.0",
    "dayjs": "^1.11.13",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pinia": "^3.0.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.5.1",
    "vue3-apexcharts": "^1.11.1",
    "vue3-google-login": "^2.1.4",
    "vuetify": "^4.1.8",
    "write-excel-file": "^4.1.1"
  },
  "prettier": "./config/prettier.config.cjs",
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.15.18",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.7.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.5.3",
    "sass": "^1.101.0",
    "standard-version": "^9.5.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.8"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
